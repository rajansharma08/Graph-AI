# Google Gemini API Key (Get from: https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Firebase Configuration
# Get credentials from: https://console.firebase.google.com/
# 1. Create a Firebase project
# 2. Go to Settings → Service Accounts
# 3. Click "Generate New Private Key"
# 4. Copy the entire JSON content below

FIREBASE_CREDENTIALS_JSON={"type": "service_account", "project_id": "your-project-id", "private_key_id": "...", "private_key": "...", "client_email": "...", "client_id": "...", "auth_uri": "...", "token_uri": "...", "auth_provider_x509_cert_url": "...", "client_x509_cert_url": "..."}

# Firebase Storage Bucket (usually: projectName.appspot.com)
FIREBASE_BUCKET=your-project-id.appspot.com

# Optional: Enable Firebase for data loading
USE_FIREBASE=true
